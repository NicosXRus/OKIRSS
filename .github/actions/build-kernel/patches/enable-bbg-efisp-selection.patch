From e0169787aafa148a55e25bdd3aae004980084c00 Mon Sep 17 00:00:00 2001
From: fatalcoder524 <11532648+fatalcoder524@users.noreply.github.com>
Date: Tue, 7 Jul 2026 08:32:46 +0000
Subject: [PATCH] Enable volume input to enable bbg efisp patch

Adapted for huangdihd/AnyKernel3 with a self-contained volume-key reader.

---
 anykernel.sh | 70 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/anykernel.sh b/anykernel.sh
index 6a97197..5360e0b 100755
--- a/anykernel.sh
+++ b/anykernel.sh
@@ -42,6 +42,76 @@ $ksu_supported || abort "  -> Non-GKI device, abort."
 # boot install
 split_boot
+
+# Menu to conditionally patch BBG for abl/efisp whitelisting
+##################################################
+read_volume_key() {
+  local events_file=/tmp/ak3_volume_events
+  local getevent_pid
+  local elapsed=0
+  local timeout_seconds=${AK3_VOLUME_KEY_TIMEOUT:-30}
+
+  KEY_RESULT=TIMEOUT
+  : > "$events_file"
+
+  if ! command -v getevent >/dev/null 2>&1; then
+    ui_print "  Volume key input is unavailable; keeping BBG protection."
+    return
+  fi
+
+  getevent -l > "$events_file" 2>&1 &
+  getevent_pid=$!
+
+  while [ "$elapsed" -le "$timeout_seconds" ]; do
+    if grep -q 'KEY_VOLUMEUP.*DOWN' "$events_file"; then
+      KEY_RESULT=KEY_VOLUMEUP
+      break
+    fi
+    if grep -q 'KEY_VOLUMEDOWN.*DOWN' "$events_file"; then
+      KEY_RESULT=KEY_VOLUMEDOWN
+      break
+    fi
+
+    sleep 1
+    elapsed=$((elapsed + 1))
+  done
+
+  kill "$getevent_pid" 2>/dev/null
+  wait "$getevent_pid" 2>/dev/null
+  rm -f "$events_file"
+}
+
+PATCH_CMDLINE=0
+ui_print " "
+ui_print "=========================================="
+ui_print " Are you using efisp exploit and require "
+ui_print " whitelisting abl and efisp partitions?   "
+ui_print "------------------------------------------"
+ui_print " 1. Yes. Whitelist abl and efisp!        "
+ui_print " 2. No. Keep as is!                      "
+ui_print "                                         "
+ui_print "        [VOL+] - Yes | [VOL-] - No       "
+ui_print "=========================================="
+ui_print " "
+
+read_volume_key
+case "$KEY_RESULT" in
+  KEY_VOLUMEUP) PATCH_CMDLINE=1 ;;
+  KEY_VOLUMEDOWN) PATCH_CMDLINE=0 ;;
+  TIMEOUT)
+    ui_print "  No volume key detected; keeping BBG protection."
+    PATCH_CMDLINE=0
+    ;;
+esac
+
+if [ "$PATCH_CMDLINE" -eq 1 ]; then
+  ui_print "Patching cmdline to allow abl and efisp flashing!!!"
+  patch_cmdline "oplusboot.secure_user_mode" "oplusboot.secure_user_mode=0"
+else
+  ui_print "Flashing the kernel as is with full BBG security!!!"
+  patch_cmdline "oplusboot.secure_user_mode" ""
+fi
+##################################################
 if [ -f "split_img/ramdisk.cpio" ]; then
     unpack_ramdisk
     write_boot
 else
-- 
